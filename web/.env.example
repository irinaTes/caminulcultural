# Copy to .env.local for development; set the same values on Vercel.

# The public address of the site, for canonical links, the sitemap and
# sharing previews. On Vercel it falls back to the production URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.ro

# Sanity (public: they end up in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=r3j22rbn
NEXT_PUBLIC_SANITY_DATASET=production

# Booking emails (Resend, https://resend.com)
# Without RESEND_API_KEY, `npm run dev` prints the emails in the terminal
# instead of sending them; production refuses bookings until it's set.
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
BOOKING_FROM_EMAIL="Căminul Cultural 31 <rezervari@your-domain.ro>"
# Where booking requests go. Optional: defaults to the email in Site settings.
BOOKING_TO_EMAIL=

# Shared secret of the Sanity webhook that refreshes the cache on publish
# (sanity.io/manage → API → Webhooks). Any long random string.
SANITY_REVALIDATE_SECRET=
